<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="8dp" /><solid android:color="#E1E7DD" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:gravity="start" android:useIntrinsicSizeAsMinimum="false">
            <shape><corners android:radius="8dp" /><solid android:color="#276658" /></shape>
        </scale>
    </item>
</layer-list>
